# /etc/ayo-sync/env — izin 600, milik user ayo.
# JANGAN menaruh nilai rahasia asli di repositori. Berkas ini hanya contoh.
#
# Buat kunci API acak sendiri (jangan lewat chat):
#     openssl rand -hex 32

# Wajib: kunci API layanan (minimal 32 karakter).
AYO_API_KEY=GANTI_DENGAN_HASIL_openssl_rand_hex_32

# Zona waktu venue (OD-2).
AYO_TZ=Asia/Makassar

# Path data dan token.
AYO_DB_PATH=/var/lib/ayo-sync/bookings.db
AYO_TOKEN_FILE=/etc/ayo-sync/mobile_token

# Level log (INFO secara bawaan).
LOG_LEVEL=INFO

# Sisanya memakai nilai bawaan (lihat SPECS §2), mis.:
# AYO_BASE_URL=https://api-new.ayo.co.id/api/v2/venue_booking/path
# AYO_VENUE_ID=3749
# AYO_FIELD_IDS=10479,10480,10481,10482,10483,10484
# AYO_WINDOW_DAYS=30
# AYO_EXPOSE_CUSTOMER=true
# AYO_EXPOSE_CUSTOMER_CONTACT=false
# AYO_CUSTOMER_ENABLED=false   # jangan aktifkan sebelum OD-9/OD-10 terjawab
